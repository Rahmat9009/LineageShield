    ]
  },
  "name": "SemanticModelKey",
  "namespace": "com.linkedin.pegasus2avro.metadata.key",
  "fields": [
    {
      "Searchable": {
        "addToFilters": true,
        "enableAutocomplete": true,
        "fieldType": "URN",
        "filterNameOverride": "Platform"
      },
      "java": {
        "class": "com.linkedin.pegasus2avro.common.urn.Urn"
      },
      "type": "string",
      "name": "platform",
      "doc": "The data platform URN that owns this semantic model\n(e.g. urn:li:dataPlatform:dbt, urn:li:dataPlatform:snowflake).\n\nREQUIRED. This field is part of the semantic model URN and therefore\nimmutable once written. If the source platform is unknown at ingest\ntime the ingestion layer is responsible for assigning a stable\nfallback URN (e.g. urn:li:dataPlatform:datahub for native /\nSDK-authored semantic models).",
      "Urn": "Urn"
    },
    {
      "Searchable": {
        "addToFilters": true,
        "fieldType": "TEXT_PARTIAL",
        "filterNameOverride": "Path"
      },
      "type": "string",
      "name": "path",
      "doc": "Namespace path that scopes this semantic model within its platform. Ingestors must set\nthis to the canonical container path so that two teams can define models with the same\n`id` on the same platform without colliding."
    },
    {
      "type": "string",
      "name": "id",
      "doc": "Unique identifier for the semantic model within its platform and path."
    }
  ],
  "doc": "Key for a Semantic Model"
}