{
  "type": "record",
  "Aspect": {
    "name": "repositoryProperties"
  },
  "name": "RepositoryProperties",
  "namespace": "com.linkedin.pegasus2avro.repository",
  "fields": [
    {
      "Searchable": {
        "boostScore": 10.0,
        "enableAutocomplete": true,
        "fieldNameAliases": [
          "_entityName"
        ],
        "fieldType": "WORD_GRAM"
      },
      "type": "string",
      "name": "name",
      "doc": "Display name of the repository, shown in UI and search results."
    },
    {
      "Searchable": {
        "fieldType": "TEXT",
        "hasValuesFieldName": "hasDescription"
      },
      "type": [
        "null",
        "string"
      ],
      "name": "description",
      "default": null,
      "doc": "Description of what this repository contains."
    },
    {
      "type": [
        "null",
        "string"
      ],
      "name": "defaultBranch",
      "default": null,
      "doc": "The default branch of the repository (e.g. \"main\", \"master\")."
    },
    {
      "type": [
        "null",
        {
          "type": "array",
          "items": "string"
        }
      ],
      "name": "languages",
      "default": null,
      "doc": "The programming languages used in the repository (e.g. [\"Python\", \"TypeScript\"]),\nconventionally ordered most-prevalent first. Repositories are frequently\npolyglot, so this is modeled as a list rather than a single value."
    },
    {
      "type": [
        "null",
        "string"
      ],
      "name": "license",
      "default": null,
      "doc": "The license of the repository (e.g. \"Apache-2.0\", \"MIT\")."
    },
    {
      "type": [
        "null",
        "string"
      ],
      "name": "homepageUrl",
      "default": null,
      "doc": "A link to the repository's homepage or documentation."
    },
    {
      "type": [
        "null",
        "boolean"
      ],
      "name": "archived",
      "default": null,
      "doc": "Whether the repository is archived (read-only / no longer maintained)."
    },
    {
      "Searchable": {
        "/time": {
          "fieldName": "createdAt",
          "fieldType": "DATETIME",
          "queryByDefault": false
        }
      },
      "type": [
        "null",
        {
          "type": "record",
          "name": "AuditStamp",
          "namespace": "com.linkedin.pegasus2avro.common",
          "fields": [
            {
              "type": "long",
              "name": "time",
              "doc": "When did the resource/association/sub-resource move into the specific lifecycle stage represented by this AuditEvent."
            },
            {
              "java": {
                "class": "com.linkedin.pegasus2avro.common.urn.Urn"
              },
              "type": "string",
              "name": "actor",
              "doc": "The entity (e.g. a member URN) which will be credited for moving the resource/association/sub-resource into the specific lifecycle stage. It is also the one used to authorize the change.",
              "Urn": "Urn"
            },
            {
              "java": {
                "class": "com.linkedin.pegasus2avro.common.urn.Urn"
              },
              "type": [
                "null",
                "string"
              ],
              "name": "impersonator",
              "default": null,
              "doc": "The entity (e.g. a service URN) which performs the change on behalf of the Actor and must be authorized to act as the Actor.",
              "Urn": "Urn"
            },
            {
              "type": [
                "null",
                "string"
              ],
              "name": "message",
              "default": null,
              "doc": "Additional context around how DataHub was informed of the particular change. For example: was the change created by an automated process, or manually."
            }
          ],
          "doc": "Data captured on a resource/association/sub-resource level giving insight into when that resource/association/sub-resource moved into a particular lifecycle stage, and who acted to move it into that specific lifecycle stage."
        }
      ],
      "name": "created",
      "default": null,
      "doc": "When this repository was created."
    },
    {
      "Searchable": {
        "/time": {
          "fieldName": "lastModifiedAt",
          "fieldType": "DATETIME",
          "queryByDefault": false
        }
      },
      "type": [
        "null",
        "com.linkedin.pegasus2avro.common.AuditStamp"
      ],
      "name": "lastModified",
      "default": null,
      "doc": "When this repository was last modified."
    }
  ],
  "doc": "Code-specific properties for a Repository entity.\n\nA Repository is a first-class representation of a source-code repository\n(GitHub, GitLab, internal SCM, etc.). It is the genesis node of the\nsoftware -> data lifecycle (repo -> service -> api -> app -> dataset) and\nproduces the services/APIs/apps cataloged elsewhere. It is NOT tabular\n(no columns / queries / stats / quality / preview)."
}