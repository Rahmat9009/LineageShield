  "name": "SemanticText",
  "namespace": "com.linkedin.pegasus2avro.common",
  "fields": [
    {
      "Searchable": {
        "fieldName": "semanticText",
        "fieldType": "TEXT",
        "searchTier": 2
      },
      "type": "string",
      "name": "text",
      "doc": "The curated embedding-source text. Keyword-indexed (under the\n`semanticText` field, matching the field this aspect replaced on\n`DocumentContents`) so it is searchable alongside the entity's primary\ncontent."
    }
  ],
  "doc": "Curated text that supersedes an entity's primary textual content as the\nsource for semantic-search embeddings.\n\nWhen present, the embedding pipeline embeds this text instead of the\nentity's own content (e.g. a document's `contents.text`); when absent,\nembeddings fall back to that content. This lets the full body stay on the\nentity while a concise, curated representation (e.g. a short summary plus\nsample questions) drives retrieval.\n\nThis aspect is a curated embedding *source*. It is distinct from\n`semanticContent`, which stores the embedding *vectors* produced by the\nembedding pipeline."
}